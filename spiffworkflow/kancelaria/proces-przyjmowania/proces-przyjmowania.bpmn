  <bpmn:process id="Process_Proces_przyjmowania" name="Proces przyjmowania" isExecutable="true">
    <bpmn:startEvent id="StartEvent_main" name="Start" />
    <bpmn:userTask id="Task_01" name="Nowa przesyłka" ><spiffworkflow:property name="formJsonSchemaFilename" value="proces-przyjmowania-edr-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="proces-przyjmowania-edr-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_02" name="Rejestr otrzymanych" ><spiffworkflow:property name="formJsonSchemaFilename" value="proces-przyjmowania-edr-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="proces-przyjmowania-edr-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_03" name="Kosz" ><spiffworkflow:property name="formJsonSchemaFilename" value="proces-przyjmowania-edr-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="proces-przyjmowania-edr-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_04" name="Archiwum" ><spiffworkflow:property name="formJsonSchemaFilename" value="proces-przyjmowania-edr-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="proces-przyjmowania-edr-uischema.json" /></bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_main" targetRef="Task_01" />
    <bpmn:sequenceFlow id="Flow_2" name="Do rejestru" sourceRef="Task_01" targetRef="Task_02" />
    <bpmn:exclusiveGateway id="Gateway_01" name="Wybór ścieżki (Rejestr otrzymanych)" default="Flow_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_02" targetRef="Gateway_01" />
    <bpmn:sequenceFlow id="Flow_5" name="Do kosza" sourceRef="Gateway_01" targetRef="Task_03">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_5'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="Pismo przychodzące" sourceRef="Gateway_01" targetRef="Task_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_6'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" name="Pismo od studenta" sourceRef="Gateway_01" targetRef="Task_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_7'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" name="Wyślij email" sourceRef="Gateway_01" targetRef="Task_02" />
    <bpmn:endEvent id="EndEvent_1" name="Koniec" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_03" targetRef="EndEvent_1" />
    <bpmn:exclusiveGateway id="Gateway_02" name="Wybór ścieżki (Archiwum)" default="Flow_9" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_04" targetRef="Gateway_02" />
    <bpmn:sequenceFlow id="Flow_9" name="[tech] Ponów pismo przychodzące" sourceRef="Gateway_02" targetRef="Task_04" />
    <bpmn:sequenceFlow id="Flow_11" name="Przywróć" sourceRef="Gateway_02" targetRef="Task_02">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_11'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
