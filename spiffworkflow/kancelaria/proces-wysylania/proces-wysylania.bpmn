    <bpmn:userTask id="Task_06" name="Sukces" ><spiffworkflow:property name="formJsonSchemaFilename" value="proces-wysylania-edr-wy-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="proces-wysylania-edr-wy-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_05" name="Problem z wysłaniem" ><spiffworkflow:property name="formJsonSchemaFilename" value="proces-wysylania-edr-wy-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="proces-wysylania-edr-wy-uischema.json" /></bpmn:userTask>
