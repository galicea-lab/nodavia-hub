    <bpmn:userTask id="Task_04" name="Zarządzanie Wysyłką" ><spiffworkflow:property name="formJsonSchemaFilename" value="proces-wysylania-edr-wy-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="proces-wysylania-edr-wy-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_08" name="Kolejka do wysłania" ><spiffworkflow:property name="formJsonSchemaFilename" value="proces-wysylania-edr-wy-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="proces-wysylania-edr-wy-uischema.json" /></bpmn:userTask>
