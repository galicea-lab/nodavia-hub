    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_08" targetRef="Gateway_05" />
    <bpmn:sequenceFlow id="Flow_13" name="Wynik pozytywny" sourceRef="Gateway_05" targetRef="Task_07" />
