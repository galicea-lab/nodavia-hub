<bpmn:userTask id="Task_01" name="Start" ><spiffworkflow:property name="formJsonSchemaFilename" value="powiadomienia-e-doreczen-pedr-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="powiadomienia-e-doreczen-pedr-uischema.json" /></bpmn:userTask>
