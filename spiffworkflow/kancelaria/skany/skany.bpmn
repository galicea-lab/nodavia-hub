    <bpmn:sequenceFlow id="Flow_5" name="Pisma i sprawy kancelarii" sourceRef="Gateway_01" targetRef="Task_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_5'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
