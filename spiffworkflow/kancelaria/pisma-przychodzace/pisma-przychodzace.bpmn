<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" id="defs_Process_Pisma_przychodzace" targetNamespace="http://bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0">
  <bpmn:process id="Process_Pisma_przychodzace" name="Pisma przychodzące" isExecutable="true">
    <bpmn:startEvent id="StartEvent_main" name="Start" />
    <bpmn:userTask id="Task_01" name="Nowe pismo" ><spiffworkflow:property name="formJsonSchemaFilename" value="pisma-przychodzace-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="pisma-przychodzace-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_02" name="Obsługa kancelaryjna pisma" ><spiffworkflow:property name="formJsonSchemaFilename" value="pisma-przychodzace-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="pisma-przychodzace-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_06" name="Decydent" ><spiffworkflow:property name="formJsonSchemaFilename" value="pisma-przychodzace-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="pisma-przychodzace-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_03" name="Pismo u adresatów" ><spiffworkflow:property name="formJsonSchemaFilename" value="pisma-przychodzace-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="pisma-przychodzace-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_05" name="Procedowanie" ><spiffworkflow:property name="formJsonSchemaFilename" value="pisma-przychodzace-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="pisma-przychodzace-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_04" name="Archiwum pism przychodzących" ><spiffworkflow:property name="formJsonSchemaFilename" value="pisma-przychodzace-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="pisma-przychodzace-uischema.json" /></bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_main" targetRef="Task_01" />
    <bpmn:sequenceFlow id="Flow_2" name="Rejestruj" sourceRef="Task_01" targetRef="Task_02" />
    <bpmn:exclusiveGateway id="Gateway_01" name="Wybór ścieżki (Obsługa kancelaryjna pisma)" default="Flow_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_02" targetRef="Gateway_01" />
    <bpmn:sequenceFlow id="Flow_3" name="Przekazanie" sourceRef="Gateway_01" targetRef="Task_03" />
    <bpmn:sequenceFlow id="Flow_5" name="Prośba o decyzję" sourceRef="Gateway_01" targetRef="Task_06">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_5'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="Przetworzone &#34;papierowo&#34;" sourceRef="Gateway_01" targetRef="Task_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_6'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" name="Przekazanie" sourceRef="Task_06" targetRef="Task_03" />
    <bpmn:exclusiveGateway id="Gateway_02" name="Wybór ścieżki (Pismo u adresatów)" default="Flow_8" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_03" targetRef="Gateway_02" />
    <bpmn:sequenceFlow id="Flow_8" name="Zapoznałem się -&#62; do archiwum" sourceRef="Gateway_02" targetRef="Task_04" />
    <bpmn:sequenceFlow id="Flow_10" name="Przekaż do procedowania" sourceRef="Gateway_02" targetRef="Task_05">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_10'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="Do teczki" sourceRef="Gateway_02" targetRef="Task_03">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_11'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_03" name="Wybór ścieżki (Procedowanie)" default="Flow_12" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_05" targetRef="Gateway_03" />
    <bpmn:sequenceFlow id="Flow_12" name="Zakończ / do archiwum" sourceRef="Gateway_03" targetRef="Task_04" />
    <bpmn:sequenceFlow id="Flow_14" name="Przekaż" sourceRef="Gateway_03" targetRef="Task_05">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_14'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" name="Do teczki" sourceRef="Gateway_03" targetRef="Task_05">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_15'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_04" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_1" name="Koniec" />
  </bpmn:process>
