<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" id="defs_Process_EOD" targetNamespace="http://bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0">
  <bpmn:process id="Process_EOD" name="EOD" isExecutable="true">
    <bpmn:startEvent id="StartEvent_main" name="Start" />
    <bpmn:userTask id="Task_01" name="Nowa przesyłka">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="eod-eod-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="eod-eod-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_02" name="Redagowanie" />
    <bpmn:userTask id="Task_03" name="EOD" />
    <bpmn:userTask id="Task_04" name="Archiwum" />
    <bpmn:userTask id="Task_05" name="Kosz" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_main" targetRef="Task_01" />
    <bpmn:sequenceFlow id="Flow_2" name="Zapisz -&#62; redagowanie treści" sourceRef="Task_01" targetRef="Task_02" />
    <bpmn:sequenceFlow id="Flow_3" name="Wyślij" sourceRef="Task_02" targetRef="Task_03" />
    <bpmn:exclusiveGateway id="Gateway_01" name="Wybór ścieżki (EOD)" default="Flow_4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_03" targetRef="Gateway_01" />
    <bpmn:sequenceFlow id="Flow_4" name="Prześlij dalej" sourceRef="Gateway_01" targetRef="Task_03" />
    <bpmn:sequenceFlow id="Flow_6" name="Przeczytane -&#62; do archiwum" sourceRef="Gateway_01" targetRef="Task_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_6'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" name="Do kosza" sourceRef="Gateway_01" targetRef="Task_05">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_7'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" name="Przywróć do redagowania" sourceRef="Task_04" targetRef="Task_02" />
    <bpmn:endEvent id="EndEvent_1" name="Koniec" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_05" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_EOD">
