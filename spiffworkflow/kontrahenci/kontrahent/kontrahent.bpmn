<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" id="defs_Process_Kontrahent" targetNamespace="http://bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0">
  <bpmn:process id="Process_Kontrahent" name="Kontrahent" isExecutable="true">
    <bpmn:startEvent id="StartEvent_main" name="Start" />
    <bpmn:userTask id="Task_01" name="Utworzenie Konta Kontrahenta" ><spiffworkflow:property name="formJsonSchemaFilename" value="kontrahent-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="kontrahent-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_02" name="Weryfikacja danych" ><spiffworkflow:property name="formJsonSchemaFilename" value="kontrahent-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="kontrahent-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_03" name="Kartoteka Kontrahentów" ><spiffworkflow:property name="formJsonSchemaFilename" value="kontrahent-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="kontrahent-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_04" name="Archiwum" ><spiffworkflow:property name="formJsonSchemaFilename" value="kontrahent-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="kontrahent-uischema.json" /></bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_main" targetRef="Task_01" />
    <bpmn:sequenceFlow id="Flow_2" name="Rejestruj" sourceRef="Task_01" targetRef="Task_02" />
    <bpmn:exclusiveGateway id="Gateway_01" name="Wybór ścieżki (Weryfikacja danych)" default="Flow_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_02" targetRef="Gateway_01" />
    <bpmn:sequenceFlow id="Flow_3" name="Weryfikuj NIP" sourceRef="Gateway_01" targetRef="Task_02" />
    <bpmn:sequenceFlow id="Flow_5" name="Do kartoteki" sourceRef="Gateway_01" targetRef="Task_03">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_5'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="Anuluj" sourceRef="Gateway_01" targetRef="Task_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_6'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" name="Do archiwum / dezaktywacja" sourceRef="Task_03" targetRef="Task_04" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_04" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_1" name="Koniec" />
  </bpmn:process>
