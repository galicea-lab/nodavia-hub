<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="defs_Process_Slownik_tematow"
                   targetNamespace="http://bpmn"
                   xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core">

<bpmn:process id="Process_Slownik_tematow" name="Słownik tematów" isExecutable="true">
<bpmn:startEvent id="StartEvent_main" name="Start" />
<bpmn:userTask id="Task_01" name="Krok słownikowy" ><spiffworkflow:property name="formJsonSchemaFilename" value="slownik-tematow-st-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="slownik-tematow-st-uischema.json" /></bpmn:userTask>
<bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_main" targetRef="Task_01" />
<bpmn:sequenceFlow id="Flow_2" sourceRef="Task_01" targetRef="Task_01" name="Zapisz" />
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_Process_Slownik_tematow">
<bpmndi:BPMNPlane id="Plane_Process_Slownik_tematow" bpmnElement="Process_Slownik_tematow">
<bpmndi:BPMNShape id="Shape_StartEvent_main" bpmnElement="StartEvent_main"><dc:Bounds x="60" y="82" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Task_01" bpmnElement="Task_01"><dc:Bounds x="280" y="60" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1"><di:waypoint x="96" y="100" /><di:waypoint x="280" y="100" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2"><di:waypoint x="380" y="100" /><di:waypoint x="280" y="100" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane>
</bpmndi:BPMNDiagram>
</bpmn:definitions>