<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="defs_Process_Lista_terminow"
                   targetNamespace="http://bpmn">

<bpmn:process id="Process_Lista_terminow" name="Lista terminów" isExecutable="true">
<bpmn:startEvent id="StartEvent_main" name="Start" />
<bpmn:userTask id="Task_01" name="Wybór terminarza" ><spiffworkflow:property name="formJsonSchemaFilename" value="lista-terminow-trm-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="lista-terminow-trm-uischema.json" /></bpmn:userTask>
<bpmn:userTask id="Task_03" name="Rejestracja terminów" ><spiffworkflow:property name="formJsonSchemaFilename" value="lista-terminow-trm-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="lista-terminow-trm-uischema.json" /></bpmn:userTask>
<bpmn:userTask id="Task_04" name="Zarejestrowane terminy" ><spiffworkflow:property name="formJsonSchemaFilename" value="lista-terminow-trm-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="lista-terminow-trm-uischema.json" /></bpmn:userTask>
<bpmn:userTask id="Task_02" name="Osobisty?" ><spiffworkflow:property name="formJsonSchemaFilename" value="lista-terminow-trm-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="lista-terminow-trm-uischema.json" /></bpmn:userTask>
<bpmn:userTask id="Task_06" name="Aktualny semestr" ><spiffworkflow:property name="formJsonSchemaFilename" value="lista-terminow-trm-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="lista-terminow-trm-uischema.json" /></bpmn:userTask>
<bpmn:userTask id="Task_08" name="Następny semestr" ><spiffworkflow:property name="formJsonSchemaFilename" value="lista-terminow-trm-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="lista-terminow-trm-uischema.json" /></bpmn:userTask>
<bpmn:userTask id="Task_07" name="Archiwalne semestry" ><spiffworkflow:property name="formJsonSchemaFilename" value="lista-terminow-trm-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="lista-terminow-trm-uischema.json" /></bpmn:userTask>
<bpmn:userTask id="Task_05" name="Odrzucone" ><spiffworkflow:property name="formJsonSchemaFilename" value="lista-terminow-trm-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="lista-terminow-trm-uischema.json" /></bpmn:userTask>
<bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_main" targetRef="Task_01" />
<bpmn:sequenceFlow id="Flow_2" sourceRef="Task_01" targetRef="Task_02" name="Rejestruj terminy" />
<bpmn:exclusiveGateway id="Gateway_02" name="Wybór ścieżki (Rejestracja terminów)" default="Flow_3" />
<bpmn:sequenceFlow id="Flow_4" sourceRef="Task_03" targetRef="Gateway_02" />
<bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_02" targetRef="Task_04" name="Gotowe" />
<bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_02" targetRef="Task_05" name="Odrzucenie">
<bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_5'</bpmn:conditionExpression>
</bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_02" targetRef="Task_06" name="Semestr aktualny">
<bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_6'</bpmn:conditionExpression>
</bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_02" targetRef="Task_08" name="Semestr przygotowywany">
<bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_7'</bpmn:conditionExpression>
</bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_8" sourceRef="Task_04" targetRef="Task_03" name="Wróć do rejestracji" />
<bpmn:exclusiveGateway id="Gateway_01" name="Wybór ścieżki (Osobisty?)" default="Flow_9" />
<bpmn:sequenceFlow id="Flow_10" sourceRef="Task_02" targetRef="Gateway_01" />
<bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_01" targetRef="Task_03" name="Rejestruj terminy">
<bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_11'</bpmn:conditionExpression>
</bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_01" targetRef="Task_03" name="Rejestruj w terminarzu osobistym" />
<bpmn:exclusiveGateway id="Gateway_03" name="Wybór ścieżki (Aktualny semestr)" default="Flow_12" />
<bpmn:sequenceFlow id="Flow_13" sourceRef="Task_06" targetRef="Gateway_03" />
<bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_03" targetRef="Task_03" name="Powrót">
<bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_14'</bpmn:conditionExpression>
</bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_03" targetRef="Task_07" name="Do archiwum" />
<bpmn:exclusiveGateway id="Gateway_04" name="Wybór ścieżki (Następny semestr)" default="Flow_15" />
<bpmn:sequenceFlow id="Flow_16" sourceRef="Task_08" targetRef="Gateway_04" />
<bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_04" targetRef="Task_06" name="Ustaw jako aktualny" />
<bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_04" targetRef="Task_07" name="Do archiwum">
<bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_17'</bpmn:conditionExpression>
</bpmn:sequenceFlow>
<bpmn:endEvent id="EndEvent_1" name="Koniec" />
<bpmn:sequenceFlow id="Flow_18" sourceRef="Task_07" targetRef="EndEvent_1" />
<bpmn:endEvent id="EndEvent_2" name="Koniec" />
<bpmn:sequenceFlow id="Flow_19" sourceRef="Task_05" targetRef="EndEvent_2" />
</bpmn:process>
