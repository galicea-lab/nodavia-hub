    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" name="Wróć do redagowania" sourceRef="Gateway_04" targetRef="Task_03">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_20'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_1" name="Koniec" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_05" targetRef="EndEvent_1" />
