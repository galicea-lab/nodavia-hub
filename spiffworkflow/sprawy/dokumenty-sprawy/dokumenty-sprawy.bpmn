  <bpmn:process id="Process_Dokumenty_Sprawy" name="Dokumenty Sprawy" isExecutable="true">
    <bpmn:startEvent id="StartEvent_main" name="Start" />
    <bpmn:userTask id="Task_01" name="Nowy Dokument" ><spiffworkflow:property name="formJsonSchemaFilename" value="dokumenty-sprawy-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="dokumenty-sprawy-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_02" name="Przypisanie teczki" ><spiffworkflow:property name="formJsonSchemaFilename" value="dokumenty-sprawy-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="dokumenty-sprawy-uischema.json" /></bpmn:userTask>
