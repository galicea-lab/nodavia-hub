  <bpmn:process id="Process_Teczka_sprawy" name="Teczka sprawy" isExecutable="true">
    <bpmn:startEvent id="StartEvent_main" name="Start" />
    <bpmn:userTask id="Task_01" name="Założenie teczki" ><spiffworkflow:property name="formJsonSchemaFilename" value="teczka-sprawy-teczka-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="teczka-sprawy-teczka-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_03" name="Teczka Otwarta" ><spiffworkflow:property name="formJsonSchemaFilename" value="teczka-sprawy-teczka-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="teczka-sprawy-teczka-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_05" name="Redagowanie Parametrów Teczki" ><spiffworkflow:property name="formJsonSchemaFilename" value="teczka-sprawy-teczka-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="teczka-sprawy-teczka-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_04" name="Archiwum" ><spiffworkflow:property name="formJsonSchemaFilename" value="teczka-sprawy-teczka-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="teczka-sprawy-teczka-uischema.json" /></bpmn:userTask>
    <bpmn:userTask id="Task_02" name="Anulowane" ><spiffworkflow:property name="formJsonSchemaFilename" value="teczka-sprawy-teczka-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="teczka-sprawy-teczka-uischema.json" /></bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_main" targetRef="Task_01" />
    <bpmn:exclusiveGateway id="Gateway_01" name="Wybór ścieżki (Założenie teczki)" default="Flow_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_01" targetRef="Gateway_01" />
    <bpmn:sequenceFlow id="Flow_2" name="Anuluj" sourceRef="Gateway_01" targetRef="Task_02" />
    <bpmn:sequenceFlow id="Flow_4" name="Załóż teczkę" sourceRef="Gateway_01" targetRef="Task_03">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_4'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_02" name="Wybór ścieżki (Teczka Otwarta)" default="Flow_5" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_03" targetRef="Gateway_02" />
    <bpmn:sequenceFlow id="Flow_5" name="Nowy dokument" sourceRef="Gateway_02" targetRef="Task_03" />
    <bpmn:sequenceFlow id="Flow_7" name="Do archiwum" sourceRef="Gateway_02" targetRef="Task_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_7'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" name="Zmiana opisu" sourceRef="Gateway_02" targetRef="Task_05">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_8'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" name="DO TERMINARZA" sourceRef="Gateway_02" targetRef="Task_03">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_9'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_03" name="Wybór ścieżki (Redagowanie Parametrów Teczki)" default="Flow_10" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_05" targetRef="Gateway_03" />
    <bpmn:sequenceFlow id="Flow_12" name="Do archiwum" sourceRef="Gateway_03" targetRef="Task_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_12'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" name="Zakończ zmiany" sourceRef="Gateway_03" targetRef="Task_03" />
    <bpmn:sequenceFlow id="Flow_13" name="Przywróć" sourceRef="Task_04" targetRef="Task_03" />
    <bpmn:endEvent id="EndEvent_1" name="Koniec" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_02" targetRef="EndEvent_1" />
  </bpmn:process>
